ENV=dev
DJANGO_SETTINGS_MODULE=ogpt.dev_settings.py
PGSERVICEFILE=.pg_service.conf
PGPASSFILE=.pgpass
DJANGO_SECRET_KEY=CHANGEME
DJANGO_ALLOWED_HOSTS="localhost,127.0.0.1"
DJANGO_DEBUG="True"

# Port Configuration (optional - defaults shown)
DJANGO_PORT=8000
